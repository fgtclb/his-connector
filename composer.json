{
    "name": "fgtclb/his-connector",
    "description": "HIS connector for TYPO3 CMS",
    "type": "typo3-cms-extension",
    "homepage": "https://www.fgtclb.com/",
    "license": "GPL-2.0-or-later",
    "keywords": [
        "typo3",
        "typo3-cms-extension",
        "his",
        "connector"
    ],
    "authors": [
        {
            "name": "FGTCLB GmbH",
            "email": "hello@fgtclb.com"
        }
    ],
    "require": {
        "php": "^8.2 || ^8.3 || ^8.4 || ^8.5",
        "typo3/cms-core": "^13.4 || ^14.3",
        "wsdltophp/packagebase": "^5.0"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.95.15",
        "nikic/php-parser": "^5.4.0",
        "phpstan/phpstan": "^2.2.5",
        "phpstan/phpstan-phpunit": "^2.0.18",
        "phpunit/phpunit": "^11.5.56",
        "saschaegerer/phpstan-typo3": "^2.1.1 || ^3.0.1",
        "typo3/testing-framework": "^9.5.0",
        "wsdltophp/packagegenerator": "^4.1"
    },
    "config": {
        "allow-plugins": {
            "php-http/discovery": true,
            "typo3/class-alias-loader": true,
            "typo3/cms-composer-installers": true
        },
        "bin-dir": ".Build/bin",
        "sort-packages": true,
        "vendor-dir": ".Build/vendor",
        "audit": {
            "block-insecure": false,
            "block-abandoned": false
        }
    },
    "autoload": {
        "psr-4": {
            "FGTCLB\\HisConnector\\": "Classes/",
            "FGTCLB\\HisClient\\": "Library/PHP/HisClient/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "FGTCLB\\HisConnector\\Tests\\": "Tests/"
        }
    },
    "scripts": {
        "cgl": "Build/Scripts/runTests.sh -s cgl",
        "phpstan": "Build/Scripts/runTests.sh -s phpstan",
        "test:unit": "Build/Scripts/runTests.sh -s unit",
        "test:functional": "Build/Scripts/runTests.sh -d sqlite -s functional",
        "docs": "Build/Scripts/runTests.sh -s renderDocumentation"
    },
    "extra": {
        "branch-alias": {
            "dev-main": "1.0.x-dev"
        },
        "typo3/cms": {
            "extension-key": "his_connector",
            "web-dir": ".Build/Web",
            "version": "1.0.0-dev",
            "Package": {
                "providesPackages": []
            }
        }
    },
    "support": {
        "issues": "https://github.com/fgtclb/his-connector/issues",
        "source": "https://github.com/fgtclb/his-connector"
    }
}
